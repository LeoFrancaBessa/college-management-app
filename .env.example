# Variables used by docker-compose (infrastructure) and passed through to the backend.
# Copy this file to ".env" (never commit the real .env) and fill in the values.

# Postgres
POSTGRES_DB=college_management
POSTGRES_USER=college_management
POSTGRES_PASSWORD=change-this-password

# Public domain served by Caddy (e.g. schedule.yourdomain.com).
# With "localhost" Caddy won't issue an automatic TLS certificate.
DOMAIN=localhost

# Authentication (single user — see docs/architecture.md)
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Backend environment: development (default) or production (secure cookies + Strict SameSite)
# Set to "production" when DOMAIN is a real FQDN behind Caddy/TLS.
ENVIRONMENT=development

# AI provider (Google Gemini)
GEMINI_API_KEY=
