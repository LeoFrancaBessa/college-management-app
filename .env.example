# Variáveis usadas pelo docker-compose (infraestrutura) e repassadas ao backend.
# Copie este arquivo para ".env" (nunca commitar o .env de verdade) e preencha os valores.

# Postgres
POSTGRES_DB=college_management
POSTGRES_USER=college_management
POSTGRES_PASSWORD=troque-esta-senha

# Domínio público servido pelo Caddy (ex.: cronograma.seudominio.com).
# Em "localhost" o Caddy não emite certificado TLS automático.
DOMAIN=localhost

# Autenticação (usuário único — ver docs/architecture.md)
JWT_SECRET_KEY=troque-este-segredo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Provedor de IA (Google Gemini)
GEMINI_API_KEY=
