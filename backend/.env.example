ENVIRONMENT=development

# Local sem Docker: SQLite é o suficiente. Em produção (docker-compose), isso é
# sobrescrito para apontar para o Postgres — ver ../.env.example e docker-compose.yml.
DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=dev-secret-troque-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

GEMINI_API_KEY=

