ENVIRONMENT=development

# Local without Docker: SQLite is enough. In production (docker-compose), this
# is overridden to point at Postgres — see ../.env.example and docker-compose.yml.
DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

VERCEL_AI_GATEWAY_API_KEY=
